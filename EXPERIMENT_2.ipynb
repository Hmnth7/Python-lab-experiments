class Bankaccount:
    def __init__(self, acc_no, name, balance=0):
        self._account_number = acc_no
        self._balance = balance
        self._pin = None

    def get_balance(self):
        return self._balance

    def set_pin(self, pin):
        if len(str(pin)) == 4 and str(pin).isdigit(): #
            return Truennn
 §        return False
class SavingsAccount(Bankaccount):
    def __init__(self, acc_no, name, balance=0):
        super().__init__(acc_no, name, balance)

    def calculate_interest(self):
        annual_rate = 0.01 # 1% annual interest
        interest = self._balance * annual_rate
        return interest
class CurrentAccount(Bankaccount):
    def __init__(self, acc_no, name, balance=0):
        super().__init__(acc_no, name, balance)
    def calculate_interest(self):
        return 0.0
class FixedDepositAccount(Bankaccount):
    def __init__(self, acc_no, name, balance=0, interest_rate=0.05, tenure_months=12):
        super().__init__(acc_no, name, balance)
        self.interest_rate = interest_rate
        self.tenure_months = tenure_months

    def calculate_interest(self):
        # Simple interest calculation
        interest = self._balance * self.interest_rate * (self.tenure_months / 12)
        return interest
savings = SavingsAccount("SB001","HEMANTH",3000)
current = CurrentAccount("CA001","Swaroop",5000)
fd=FixedDepositAccount("FD001", "Nikhil",20000)

accounts = [savings,current,fd]

for acc in accounts:
  print(f"Account {acc._account_number} Interest: {acc.calculate_interest():.2f}")
