from functools import reduce

# 1. Take 3 Customer Purchase Records via User Input
print("Enter details for 3 Customer Purchases:")
purchases = list(map(lambda i: {
    "id": int(input(f"\n[Record {i+1}] Customer ID: ")),
    "name": input(f"[Record {i+1}] Customer Name: "),
    "product": input(f"[Record {i+1}] Product Name: "),
    "price": float(input(f"[Record {i+1}] Price: ")),
    "qty": int(input(f"[Record {i+1}] Quantity: "))
}, range(3)))

# 2. MAP & LAMBDA: Calculate total amount for each record
processed = list(map(lambda x: {**x, "total": x["price"] * x["qty"]}, purchases))

# 3. FILTER & LAMBDA: Identify high-value purchases based on threshold
limit = float(input("\nEnter threshold amount for high-value purchases (e.g. 200): "))
high_value = list(filter(lambda x: x["total"] > limit, processed))

# 4. DISCOUNT & SAVINGS: 10% discount on purchases exceeding threshold
discounted = list(map(lambda x: {
    **x,
    "discount": (x["total"] * 0.10) if x["total"] > limit else 0.0,
    "final_price": (x["total"] * 0.90) if x["total"] > limit else x["total"]
}, processed))

# 5. REDUCE & LAMBDA: Calculate total sales, money saved, and highest purchase
total_sales = reduce(lambda acc, x: acc + x["total"], processed, 0)
total_money_saved = reduce(lambda acc, x: acc + x["discount"], discounted, 0)
final_total_sales = total_sales - total_money_saved
avg_sales = total_sales / len(processed)
highest_purchase = reduce(lambda a, b: a if a["total"] > b["total"] else b, processed)

# Total sales for a selected product
search_prod = input("\nEnter product name to calculate total sales: ")
product_sales = reduce(lambda acc, x: acc + x["total"], filter(lambda x: x["product"].lower() == search_prod.lower(), processed), 0)

# --- Display Output ---
print("\n--- ALL PROCESSED PURCHASES ---")
list(map(lambda x: print(f"{x['name']} bought {x['qty']}x {x['product']} -> Total: ${x['total']:.2f} | Discount: ${x['discount']:.2f} | Final: ${x['final_price']:.2f}"), discounted))

print(f"\n--- HIGH-VALUE PURCHASES (> ${limit:.2f}) ---")
list(map(lambda x: print(f"{x['name']} - {x['product']}: ${x['total']:.2f}"), high_value))

print(f"\n--- SUMMARY STATISTICS ---")
print(f"Total Sales (Original): ${total_sales:.2f}")
print(f"Total Money Saved: ${total_money_saved:.2f}")
print(f"Total Sales (After Discount): ${final_total_sales:.2f}")
print(f"Average Purchase Value: ${avg_sales:.2f}")
print(f"Highest Value Purchase: {highest_purchase['name']} (${highest_purchase['total']:.2f})")
print(f"Total '{search_prod}' Sales: ${product_sales:.2f}")


